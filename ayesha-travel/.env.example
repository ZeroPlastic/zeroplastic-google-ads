# Ayesha Travel — enquiry email settings
# Copy to .env for local testing (never commit .env). On Vercel or Netlify,
# add these in the project's Environment Variables settings instead.

# API key from https://resend.com/api-keys (needs "Sending access").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Ayesha's inbox. Several addresses may be comma-separated.
ENQUIRY_TO_EMAIL=ayesha@your-domain.example

# Sender address on a domain you have verified in Resend (Domains → Add domain).
# The visitor's email is set as Reply-To, so replying goes straight to them.
ENQUIRY_FROM_EMAIL=Ayesha Travel Website <enquiries@your-domain.example>

# Optional: only accept submissions from these origins (comma-separated, no trailing slash).
# ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Optional: basic rate limit per IP address (defaults: 5 enquiries per 15 minutes).
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MINUTES=15

# Local preview server port (npm run dev).
# PORT=8080
